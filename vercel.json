{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "convertly0.vercel.app" }],
      "destination": "https://convertly.is-cool.dev/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/tools", "destination": "/index.html" },
    { "source": "/tools/:id", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" }
  ]
}
